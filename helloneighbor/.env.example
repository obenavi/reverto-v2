# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Stripe ----
# For charging providers their subscription, and nothing else. No payment
# between a neighbour and a provider passes through this app or this account —
# see lib/stripe.ts and tests/no-customer-payments.test.mjs.
# Developers -> API keys. Use sk_test_ locally, sk_live_ in production.
STRIPE_SECRET_KEY=sk_test_...

# ---- Pilot ----
# Set this and NOBODY is charged before that date — no promo codes to hand out,
# no rows to update. Leave it unset outside a pilot. An ISO date; a value this
# cannot parse is IGNORED and logged, because a typo meaning "free forever"
# would silently switch off the only revenue the product has.
# PILOT_FREE_UNTIL=2026-12-31

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ---- Supervisor agent (Claude) ----
# Reviews signups, listings, and booking notes against the community
# guidelines. Without it, content is flagged for manual review instead.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Email (Resend) ----
# Guardian consent for under-16 signups is delivered by email. Without these
# the message is logged to the server console instead of sent, so local
# development works — but consent cannot actually reach a parent.
RESEND_API_KEY=
EMAIL_FROM=HelloNeighbor <noreply@yourdomain.com>

# ---- Bot challenge (Cloudflare Turnstile) ----
# Free at dash.cloudflare.com -> Turnstile. Without these the challenge is
# skipped entirely — set them before launch. Rate limiting works regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Push notifications ----
# Generate a pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:safety@helloneighbor.app

# ---- Age verification ----
# A purpose-built facial age-estimation service (Yoti, Persona, Incode,
# Veriff). Leave blank and the feature is off — applications go to manual
# review instead, which still works.
#
# Never store the image. See lib/ageverify.ts for why: a retained face image
# or template is a biometric identifier under Illinois BIPA, Texas CUBI and
# GDPR Article 9. Check the provider's own retention policy before signing.
AGE_PROVIDER_URL=
AGE_PROVIDER_API_KEY=

# ---- Safety ----
# Urgent reports (safety, inappropriate content, age concerns) text this number
# immediately instead of waiting to be noticed in the admin queue.
SAFETY_ALERT_PHONE=

# ---- App ----
# Password for the admin area. Change this before deploying.
ADMIN_PASSWORD=demo123
# Optional. When set, /admin/login 404s unless reached as
#   /admin/login?k=<this value>
# so the entrance is unlisted rather than merely unlinked. Use a long random
# string; bookmark the full URL.
ADMIN_ACCESS_KEY=
# Optional. Comma-separated IPs allowed to see the admin area at all.
# Everything else gets a 404. Leave blank to allow any IP.
ADMIN_ALLOWED_IPS=
# Signs the operator and admin session cookies. Any long random string.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Used to build shareable booking, conversation, and guardian-consent links.
# Must be the real public URL in production or those links will be unusable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set by Vercel when you add a cron job; protects /api/cron/sweep.
CRON_SECRET=
