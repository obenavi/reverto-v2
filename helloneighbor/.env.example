# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Stripe ----
# Developers -> API keys. Use pk_test_/sk_test_ locally, pk_live_/sk_live_ in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ---- Supervisor agent (Claude) ----
# Reviews signups, listings, and booking notes against the community
# guidelines. Without it, content is flagged for manual review instead.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Bot challenge (Cloudflare Turnstile) ----
# Free at dash.cloudflare.com -> Turnstile. Without these the challenge is
# skipped entirely — set them before launch. Rate limiting works regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- App ----
# Password for /admin/login. Change this before deploying.
ADMIN_PASSWORD=demo123
# Signs the operator and admin session cookies. Any long random string.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Used to build shareable booking, conversation, and guardian-consent links.
# Must be the real public URL in production or those links will be unusable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set by Vercel when you add a cron job; protects /api/cron/sweep.
CRON_SECRET=
